{
  "url": "https://generaly.top",
  "displayUrl": "generaly.top",
  "viewport": { "width": 1440, "height": 810 },
  "brand": {
    "background": "#050810",
    "accent": "#3b82f6"
  },
  "initialWait": 1200,
  "tail": 1200,
  "steps": [
    { "action": "wait", "ms": 700 },
    {
      "action": "click",
      "text": "效果实测",
      "pause": 1200,
      "zoom": false,
      "caption": "先看真实修复效果"
    },
    { "action": "scroll", "y": 240, "pause": 600, "zoom": false },
    { "action": "wait", "ms": 300 },
    {
      "action": "drag",
      "selector": "#sliderHandle",
      "dx": 300,
      "dy": 0,
      "pause": 900,
      "zoom": false,
      "caption": "拖动分割线，对比原图与修复"
    },
    { "action": "wait", "ms": 700 },
    {
      "action": "click",
      "text": "场景二：全屏暗调图文标识",
      "pause": 900,
      "zoom": false,
      "caption": "复杂暗调场景也能处理"
    },
    { "action": "wait", "ms": 700 },
    {
      "action": "click",
      "text": "版本下载",
      "pause": 1200,
      "zoom": false,
      "caption": "Windows 原生，本地离线处理"
    },
    { "action": "wait", "ms": 900 }
  ]
}
