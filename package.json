{
  "name": "@gnawbit/tabretake",
  "version": "0.5.2",
  "description": "Create repeatable web app demos, README GIFs and 9:16 videos from editable JSON steps or existing screen recordings. Local CLI and Agent Skill for Claude Code, Codex and Cursor.",
  "type": "module",
  "bin": {
    "tabretake": "bin/tabretake.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "schemas/",
    "references/",
    "agents/",
    "examples/site/",
    "examples/stories/",
    "examples/story.json",
    "examples/story-video.json",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tools/test.mjs",
    "doctor": "node bin/tabretake.mjs doctor",
    "serve": "node bin/tabretake.mjs serve",
    "demo": "node bin/tabretake.mjs demo"
  },
  "keywords": [
    "demo",
    "product-demo",
    "readme-gif",
    "screen-recording",
    "walkthrough",
    "9-16",
    "vertical-video",
    "video",
    "gif",
    "playwright",
    "ffmpeg",
    "headless",
    "cursor",
    "agent-skill",
    "claude-code",
    "codex",
    "product-launch"
  ],
  "license": "MIT",
  "author": "gnawbit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnawbit/tabretake.git"
  },
  "homepage": "https://gnawbit.github.io/tabretake/",
  "bugs": {
    "url": "https://github.com/gnawbit/tabretake/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^1.1.0",
    "ajv": "^8.20.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
