{
  "name": "@gnawbit/demo-reel",
  "version": "0.3.0",
  "description": "Record repeatable web app demos, README GIFs and portrait launch videos from editable JSON steps. Local CLI and Agent Skill for Claude Code, Codex and Cursor.",
  "type": "module",
  "bin": {
    "demo-reel": "./bin/demo-reel.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "schemas/",
    "references/",
    "agents/",
    "examples/site/",
    "examples/stories/",
    "examples/story.json",
    "examples/story-video.json",
    "SKILL.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "doctor": "node bin/demo-reel.mjs doctor",
    "serve": "node bin/demo-reel.mjs serve",
    "demo": "node bin/demo-reel.mjs demo"
  },
  "keywords": [
    "demo",
    "video",
    "gif",
    "playwright",
    "ffmpeg",
    "agent-skill",
    "claude-code",
    "codex",
    "product-launch"
  ],
  "license": "MIT",
  "author": "gnawbit",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gnawbit/demo-reel.git"
  },
  "homepage": "https://github.com/gnawbit/demo-reel",
  "bugs": {
    "url": "https://github.com/gnawbit/demo-reel/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^1.1.0",
    "ajv": "^8.20.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
